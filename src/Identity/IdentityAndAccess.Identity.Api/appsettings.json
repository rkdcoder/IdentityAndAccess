{
  "DirectoryServices": {
    "ContextOptions": "Negotiate",
    "TimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=MyDatabase;...."
  },
  "HttpGossip": {
    "DatabaseName": "SqlServer",
    "ConnectionString": "Server=MyDatabase;....",
    "TableQualifiedName": "logs.WSLOG_IdentityAndAccess",
    "QueueCapacity": 10000,
    "MaxBodyBytes": 65536,
    "SensitivePaths": [ "/login", "/password", "/token" ],
    "BypassPaths": [ "/scalar", ".js", ".css", "/health" ]
  },
  "Credentials": {
    "Username": "myusername",
    "Password": "MyPassword"
  }
}
